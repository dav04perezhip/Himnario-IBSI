{
  // API del Himnario IBSI: guarda las alabanzas que se publican "para todos".
  "name": "himnario-ibsi-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "himnario-ibsi",
      "database_id": "ac95e739-f8b8-4baf-b5b4-30cd90cb187c"
    }
  ],
  // Modo director: una "sala" por código de sesión (WebSockets en vivo).
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }]
  },
  "migrations": [{ "tag": "v1-live", "new_sqlite_classes": ["LiveRoom"] }],
  "vars": {
    // Las alabanzas nuevas siguen la numeración del himnario (las originales son 1–214).
    "FIRST_NUMBER": "215",
    "ALLOWED_ORIGINS": "https://himnario-ibsi.hiptank-news.workers.dev,https://dav04perezhip.github.io,http://localhost:8000,http://127.0.0.1:8000"
  }
  // La clave de administrador NO va aquí. Se guarda como secreto:
  //   npx wrangler secret put ADMIN_PIN
}
