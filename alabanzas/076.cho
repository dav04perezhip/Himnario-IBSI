{title: Somos el Pueblo de Dios}
{key: E}

// SOMOS EL PUEBLO DE DI[E]OS,
SOMOS UN PUEBLO ESPEC[C#m]IAL;
LLAMADOS PARA ANUNCI[A]AR[-],[F#m]
LAS VIRTUDES DE AQU[B]EL
