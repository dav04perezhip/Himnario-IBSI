{title: Y tú Belén}
{key: Dm}
{flats: true}

Y [Dm]TÚ BELÉN, TIERRA [A7]DE JUDÁ,
Y TÚ BELÉN, TIERRA DE JUD[Dm]Á;
//NO[Gm] ERE[C7]S PEQUEÑ[F]I[-]T[Bb]A,
PUES DE T[A7]I SALDRÁ EL GUIADO[Dm]R.//

PROM[Dm]ESA FIEL EL PROF[A7]ETA DIO,
PROMESA FIEL EL PROFETA DI[Dm]O;
//Y AL [Gm]TIEM[C7]PO EN TUS C[F]A[-][Bb]MPOS
EL SEÑ[A7]OR JESÚS NACI[Dm]Ó.//

DIOS [Dm]HA MOSTRADO SU GR[A7]AN AMOR,
DIOS HA MOSTRADO SU GRAN AM[Dm]OR;
//¡CANT[Gm]ADL[C7]E CIELO Y TI[F]E[-]R[Bb]RA
Y ADOR[A7]AD AL SALVAD[Dm]OR!//
