{title: Dios de Pactos}
{key: A}

CORO: DIOS DE P[A]ACTOS, QUE GUARDAS TUS PROM[D]ESAS,
QUE CUMPLES T[A]U PALAB[Bm]RA, QUE GUÍAS MI DEST[A]INO[E];
